# Tastio Selenium E2E Test Suite Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Target Base URL
TEST_BASE_URL=http://127.0.0.1:5000

# Browser Selection: chrome, edge, firefox
SELENIUM_BROWSER=chrome

# Headless Execution: true for CI/background, false for visible desktop window
HEADLESS_MODE=true

# Explicit Wait Timeout in Milliseconds
EXPLICIT_WAIT_TIMEOUT=10000

# Window Dimensions
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# Isolated Test User Credentials (DO NOT USE PRODUCTION SECRETS)
TEST_USER_NAME=Selenium Test Chef
TEST_USER_EMAIL=selenium_chef@test.local
TEST_USER_PASSWORD=TestPass123!

# Test Artifacts and Reports
REPORT_DIR=./reports
SCREENSHOT_ON_FAILURE=true

